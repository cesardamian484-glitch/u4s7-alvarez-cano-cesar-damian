# venv/: no se sube el entorno virtual completo, cada quien crea el suyo con requirements.txt
venv/
# .env: el archivo con tus contraseñas reales, nunca debe llegar a GitHub
.env
# __pycache__/: archivos compilados que Python genera solo, no son código fuente
__pycache__/
# staticfiles/: NUEVO — carpeta que genera collectstatic; Render la crea de nuevo en cada deploy
staticfiles/
